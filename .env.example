# ─── Kaizen Dashboard — Environment Configuration ───

# Local MongoDB (offline database)
MONGO_LOCAL_URI=mongodb://localhost:27017
DB_NAME=ExamPrep

# MongoDB Atlas (online sync — leave empty to run local-only)
# Get your connection string from https://cloud.mongodb.com
MONGO_ATLAS_URI=

# Server
PORT=3000

# Password Vault — master key for encrypting/decrypting stored passwords
# Choose a strong, unique passphrase. All vault data is AES-256-GCM encrypted with this key.
# ⚠ Changing this after saving passwords will make existing entries unreadable!
VAULT_MASTER_KEY=your-secret-vault-key-here
